# This service's OWN independent Postgres database — not shared with
# web-internal (see prisma/schema.prisma's header comment). This service
# owns its schema/migrations now (prisma/migrations/).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Signs this backend's own JWTs. Independent from web-internal's JWT_SECRET.
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-value"

PORT=4000

# Resend (https://resend.com) — sends real OTP emails (password reset, email
# change, account verification). Sign up, verify a sending domain (or use
# their onboarding@resend.dev sandbox address for testing), create an API
# key. If RESEND_API_KEY is unset, OTPs are just logged to the console
# instead of emailed (see src/otp.ts) — fine for local dev, not for prod.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Trusted Gemlab <noreply@trustedgemlab.com>"

# Web Push (browser notifications for trusted-gemlab-web — separate
# mechanism from the mobile app's Expo push tokens, see src/push.ts).
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# then never change these — every existing browser subscription is tied to
# this exact key pair; rotating it invalidates all of them.
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:noreply@trustedgemlab.com"
